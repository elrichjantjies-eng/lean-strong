<?xml version="1.0" encoding="utf-8"?>
<!-- Yellow header band inside a widget card, with an ink rule underneath. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF111111" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
        </shape>
    </item>
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFD21F" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
        </shape>
    </item>
</layer-list>
