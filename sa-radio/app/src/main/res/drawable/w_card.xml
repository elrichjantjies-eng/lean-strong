<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: white, ink outline, hard ink shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF111111" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="2.5dp" android:color="#FF111111" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
