<?xml version="1.0" encoding="utf-8"?>
<!-- Live scores, fixtures and results: South African teams and players. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card"
    android:orientation="vertical"
    android:paddingStart="2.5dp"
    android:paddingTop="2.5dp"
    android:paddingEnd="5.5dp"
    android:paddingBottom="5.5dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/w_head"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2.5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/anton"
            android:text="SPORT"
            android:textColor="#FF111111"
            android:textSize="22sp" />
        <TextView
            android:includeFontPadding="false"
            android:id="@+id/w_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/grotesk_bold"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="SA FOCUS"
            android:textColor="#FF111111"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Refresh scores"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FF111111" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="10dp"
            android:clipToPadding="true"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:includeFontPadding="false"
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/grotesk_medium"
            android:gravity="center"
            android:padding="16dp"
            android:text="No scores yet. Tap refresh."
            android:textColor="#FF2B2B2B"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
