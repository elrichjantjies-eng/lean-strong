<?xml version="1.0" encoding="utf-8"?>
<!-- The pocket radio: aerial, speaker with the station's logo, tuning dial and buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:layout_width="78dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/w_antenna" />

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="17dp"
        android:background="@drawable/w_radio_body"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/w_speaker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="34"
            android:background="@drawable/w_speaker">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/w_grille" />

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="66"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_dial"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/w_plate"
                    android:contentDescription="Previous station"
                    android:padding="10dp"
                    android:src="@drawable/ic_tune_prev"
                    android:tint="#FF111111" />

                <ImageView
                    android:id="@+id/w_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/w_disc"
                    android:contentDescription="Play"
                    android:padding="11dp"
                    android:src="@drawable/ic_play"
                    android:tint="#FFFFD21F" />

                <ImageView
                    android:id="@+id/w_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/w_plate"
                    android:contentDescription="Next station"
                    android:padding="10dp"
                    android:src="@drawable/ic_tune_next"
                    android:tint="#FF111111" />

                <TextView
                    android:includeFontPadding="false"
                    android:id="@+id/w_band"
                    android:layout_width="46dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/w_band"
                    android:fontFamily="@font/grotesk_bold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="0.9"
                    android:text="BAND\nA–Z"
                    android:textColor="#FFFFD21F"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
