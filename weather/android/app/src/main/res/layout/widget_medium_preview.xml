<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/glass_clear" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_pad">

        <!-- Medium 4×2: current conditions and the next hours. -->
        <!-- Top row: place on the left, last update and refresh on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pin"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_navigation" />

            <TextView
                android:id="@+id/place"
                style="@style/WidgetText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cape Town"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/updated"
                style="@style/WidgetText.Faint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:05"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/refresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Refresh"
                android:padding="4dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Current conditions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temp"
                style="@style/WidgetText.Big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21°"
                android:textSize="40sp" />

            <ImageView
                android:id="@+id/icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wx_partly_day" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cond"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partly cloudy"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/hilo"
                    style="@style/WidgetText.Dim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="H:24°  L:15°"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/feels"
                    style="@style/WidgetText.Faint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Feels like 20° · Rain 10%"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hourly forecast (filled in code; the number of hours follows the widget width). -->
        <LinearLayout
            android:id="@+id/hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/glass_inner"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <include layout="@layout/widget_hour_item" />
            <include layout="@layout/widget_hour_item" />
            <include layout="@layout/widget_hour_item" />
            <include layout="@layout/widget_hour_item" />
            <include layout="@layout/widget_hour_item" />
            <include layout="@layout/widget_hour_item" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
